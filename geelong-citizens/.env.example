# --- Claude (drafting) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides
# DRAFT_MODEL=claude-opus-5-5
# DRAFT_EFFORT=low

# --- Site ---
PORT=3000
# Public URL of the site, used in confirmation links
PUBLIC_URL=http://localhost:3000
# Set to 1 when running behind a reverse proxy / PaaS (Render, Fly, Railway...)
# TRUST_PROXY=1

# --- Email sending ("Send it for me") ---
# MAIL_TRANSPORT=smtp     -> real sending via SMTP (Resend, Postmark, SES, Mailgun...)
# MAIL_TRANSPORT=console  -> development: print emails to the terminal instead
# unset                   -> "Send it for me" is hidden; supporters use their own email app
MAIL_TRANSPORT=console
MAIL_FROM_ADDRESS=campaigns@geelongcitizens.com
MAIL_FROM_NAME=Geelong Citizens
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_...
